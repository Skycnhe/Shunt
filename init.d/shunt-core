#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-3.0-or-later
# Shunt 代理核心（服务名 shunt-core）：按 /etc/mihomo-panel/core 选择 mihomo、mihomo Smart 或 sing-box（面板「设置 → 核心 → 内核」切换）
CORE=$(cat /etc/mihomo-panel/core 2>/dev/null)
name="shunt-core"
if [ "$CORE" = "singbox" ] && [ -x /usr/local/bin/sing-box ]; then
  description="sing-box proxy core"
  command="/usr/local/bin/sing-box"
  command_args="run --disable-color -c /etc/sing-box/config.json -D /etc/sing-box"
elif [ "$CORE" = "smart" ] && [ -x /usr/local/bin/mihomo-smart ]; then
  description="mihomo Smart proxy core"
  command="/usr/local/bin/mihomo-smart"
  command_args="-d /etc/mihomo"
else
  description="mihomo proxy core"
  command="/usr/local/bin/mihomo"
  command_args="-d /etc/mihomo"
fi
# 文件句柄：conf.d 没设置 rc_ulimit 时按本机硬上限提高（最多 1048576）。默认 1024 在 TUN / TProxy 下连接一多就用完，
# 核心进程还在但控制接口 accept 失败，看门狗判定「控制接口无响应」反复重启
if [ -z "$rc_ulimit" ]; then
  _h=$(ulimit -Hn 2>/dev/null)
  case "$_h" in ''|unlimited) _h=1048576;; esac
  [ "$_h" -gt 1048576 ] 2>/dev/null && _h=1048576
  rc_ulimit="-n $_h"
fi
command_background=true
retry="TERM/15/KILL/5"  # 先给核心 15 秒正常退出：sing-box 只在正常退出时把 Fake-IP 映射写入 cache.db，被直接 kill 会全部丢失
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/mihomo.log"
error_log="/var/log/mihomo.log"

depend() { need net; after firewall; }
start_pre() { : > /var/log/mihomo.log; modprobe tun 2>/dev/null; mkdir -p /etc/sing-box; python3 /opt/mihomo-panel/server.py --gen >/dev/null; }
start_post() { sleep 1; /opt/mihomo-panel/tproxy.sh apply || ewarn "透明代理规则加载失败（内核缺少 nftables / TProxy 模块？），核心照常运行，可改用 TUN 模式"; return 0; }  # 按代理方式：TProxy 全量规则 / TUN 仅 DNS 重定向 / 关闭
stop_post() { /opt/mihomo-panel/tproxy.sh stop; }
